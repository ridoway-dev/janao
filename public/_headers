# Security and caching headers (Cloudflare Pages / Netlify compatible).
# HSTS removes the extra http -> https redirect for returning visitors.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Next.js fingerprints these files, so they can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Text assets that change rarely.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
